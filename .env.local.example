# ─── Opinion Blog — Variables d'environnement ───

# URL publique du site (requis pour SEO / sitemap / RSS)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─── LLM (génération des articles d'opinion) ───
# Provider compatible OpenAI : OpenAI, Mistral, Groq, Together, etc.
#
# 1) OpenAI (défaut) :
#    LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
#    LLM_MODEL=gpt-4o-mini
#
# 2) Mistral AI :
#    LLM_API_KEY=jqEuxxxxxxxxxxxxxxxxxxxxxxxx
#    LLM_MODEL=mistral-small-latest
#    LLM_BASE_URL=https://api.mistral.ai/v1
#
# 3) Groq (ultra-rapide, gratuit) :
#    LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
#    LLM_MODEL=llama-3.3-70b-versatile
#    LLM_BASE_URL=https://api.groq.com/openai/v1
#
# Rétro-compatibilité : OPENAI_API_KEY / OPENAI_MODEL toujours lus.
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.mistral.ai/v1

# (anciens noms — toujours supportés)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini

# ─── GNews API (source d'actualités) ───
# Clé gratuite sur https://gnews.io (100 req/jour)
GNEWS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Flux RSS (optionnel, séparés par virgules) ───
RSS_FEEDS=https://feeds.lemonde.fr/c/205/f/3000/index.rss,https://www.francetvinfo.fr/titres.rss

# ─── Cron secret (sécurité de /api/cron) ───
# Générer un secret aléatoire : openssl rand -hex 32
CRON_SECRET=remplacer-par-un-secret-aleatoire

# ─── Git auto-commit (persistance Vercel) ───
# Chaque article généré est commité sur le repo pour persister sur Vercel.
# En local : laisser vide (les fichiers restent sur disque seulement).
#
# Créer un Personal Access Token sur GitHub :
#   Settings → Developer settings → Personal access tokens → Fine-grained
#   Permissions : Contents = Read and write
#
GIT_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GIT_REPO=mitchell94/opinion-blog
GIT_BRANCH=main
GIT_AUTHOR=Tribune Bot
GIT_EMAIL=bot@tribune.local